---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
  noindex?: boolean;
}

const DEFAULT_DESCRIPTION =
  'Особистий блог-стрічка JoeWline: нотатки, роздуми та кейси про мікроконтролери, іграшки на залізі й автоматизацію через ШІ.';

const {
  title,
  description = DEFAULT_DESCRIPTION,
  image,
  type = 'website',
  publishedTime,
  noindex = false,
} = Astro.props;

const pageTitle = `${title} — joewline`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(image ?? `${import.meta.env.BASE_URL}og-default.png`, Astro.site);

// JSON-LD — структуровані дані для пошуковиків і AI-агентів (Perplexity,
// ChatGPT search тощо), які саме звідси найохочіше беруть заголовок/дату/
// автора для цитування, а не парсять довільний HTML.
const jsonLd =
  type === 'article'
    ? {
        '@context': 'https://schema.org',
        '@type': 'BlogPosting',
        headline: title,
        description,
        image: ogImageURL.href,
        url: canonicalURL.href,
        datePublished: publishedTime,
        dateModified: publishedTime,
        inLanguage: 'uk',
        author: { '@type': 'Person', name: 'JoeWline' },
        publisher: {
          '@type': 'Organization',
          name: 'joewline',
          logo: { '@type': 'ImageObject', url: new URL(`${import.meta.env.BASE_URL}apple-touch-icon.png`, Astro.site).href },
        },
        mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalURL.href },
      }
    : {
        '@context': 'https://schema.org',
        '@type': 'Blog',
        name: 'joewline',
        description,
        url: canonicalURL.href,
        inLanguage: 'uk',
      };
---
<!doctype html>
<html lang="uk">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#1c2126" />
    <script is:inline>
      // Виставляємо збережені класи доступності ДО першого малювання
      // сторінки (is:inline — щоб скрипт лишився синхронним і не чекав на
      // обробку модулів), інакше на мить блимне дефолтний вигляд.
      (function () {
        try {
          var saved = JSON.parse(localStorage.getItem('a11y-settings') || '{}');
          var root = document.documentElement;
          if (saved.fontSize) root.classList.add('a11y-font-' + saved.fontSize);
          if (saved.contrast) root.classList.add('a11y-contrast');
          if (saved.dyslexia) root.classList.add('a11y-dyslexia');
          if (saved.underlineLinks) root.classList.add('a11y-underline-links');
          if (saved.reduceMotion) root.classList.add('a11y-reduce-motion');
        } catch (e) {}
      })();
    </script>
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}jwl-icon.svg`} />
    <link rel="apple-touch-icon" href={`${import.meta.env.BASE_URL}apple-touch-icon.png`} />
    <link rel="manifest" href={`${import.meta.env.BASE_URL}manifest.webmanifest`} />
    <link rel="canonical" href={canonicalURL} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow'} />

    <meta property="og:site_name" content="joewline" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:locale" content="uk_UA" />
    {type === 'article' && publishedTime && <meta property="article:published_time" content={publishedTime} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <header class="site-header">
      <a href={import.meta.env.BASE_URL} class="brand">
        <img src={`${import.meta.env.BASE_URL}jwl-logo-horizontal.svg`} alt="joewline" height="52" />
      </a>
      <nav class="site-nav">
        <a href={import.meta.env.BASE_URL}>стрічка</a>
        <a href={`${import.meta.env.BASE_URL}tags/`}>теги</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <a href="https://t.me/jwl_blog" target="_blank" rel="noopener noreferrer">Telegram-канал</a>
    </footer>

    <div class="a11y-widget">
      <button
        type="button"
        id="a11y-toggle"
        class="a11y-toggle-btn"
        aria-expanded="false"
        aria-controls="a11y-panel"
        aria-label="Налаштування доступності"
      >
        <span aria-hidden="true">Aa</span>
      </button>
      <div class="a11y-panel" id="a11y-panel" role="region" aria-label="Налаштування доступності" hidden>
        <h2>Доступність</h2>

        <div class="a11y-row">
          <span id="a11y-fontsize-label">Розмір тексту</span>
          <div class="a11y-btn-group" role="group" aria-labelledby="a11y-fontsize-label">
            <button type="button" data-a11y-fontsize="" aria-label="Звичайний розмір">A</button>
            <button type="button" data-a11y-fontsize="lg" aria-label="Більший розмір">A+</button>
            <button type="button" data-a11y-fontsize="xl" aria-label="Найбільший розмір">A++</button>
          </div>
        </div>

        <label class="a11y-row a11y-toggle-row">
          <span>Високий контраст</span>
          <input type="checkbox" data-a11y-toggle="contrast" />
        </label>

        <label class="a11y-row a11y-toggle-row">
          <span>Шрифт для дислексії</span>
          <input type="checkbox" data-a11y-toggle="dyslexia" />
        </label>

        <label class="a11y-row a11y-toggle-row">
          <span>Підкреслювати посилання</span>
          <input type="checkbox" data-a11y-toggle="underlineLinks" />
        </label>

        <label class="a11y-row a11y-toggle-row">
          <span>Менше анімації</span>
          <input type="checkbox" data-a11y-toggle="reduceMotion" />
        </label>

        <button type="button" class="a11y-reset" id="a11y-reset">Скинути</button>
      </div>
    </div>
  </body>
</html>

<script>
  function setupCarousels() {
    document.querySelectorAll<HTMLElement>('.carousel').forEach((carousel) => {
      const track = carousel.querySelector<HTMLElement>('.carousel-track');
      const slides = Array.from(carousel.querySelectorAll<HTMLElement>('.carousel-slide'));
      const dots = Array.from(carousel.querySelectorAll<HTMLElement>('.carousel-dot'));
      const prev = carousel.querySelector<HTMLButtonElement>('.carousel-prev');
      const next = carousel.querySelector<HTMLButtonElement>('.carousel-next');
      if (!track || slides.length === 0) return;

      const currentIndex = () => Math.round(track.scrollLeft / track.clientWidth);

      const scrollToIndex = (i: number) => {
        const clamped = Math.max(0, Math.min(slides.length - 1, i));
        track.scrollTo({ left: slides[clamped].offsetLeft, behavior: 'smooth' });
      };

      prev?.addEventListener('click', () => scrollToIndex(currentIndex() - 1));
      next?.addEventListener('click', () => scrollToIndex(currentIndex() + 1));
      dots.forEach((dot, i) => dot.addEventListener('click', () => scrollToIndex(i)));

      const updateDots = () => {
        const active = currentIndex();
        dots.forEach((dot, i) => dot.classList.toggle('is-active', i === active));
      };
      track.addEventListener('scroll', () => window.requestAnimationFrame(updateDots));
      updateDots();
    });
  }

  function setupLightbox() {
    const overlay = document.createElement('div');
    overlay.className = 'lightbox';
    const overlayImg = document.createElement('img');
    const closeBtn = document.createElement('button');
    closeBtn.type = 'button';
    closeBtn.className = 'lightbox-close';
    closeBtn.setAttribute('aria-label', 'Закрити');
    closeBtn.textContent = '×';
    overlay.append(overlayImg, closeBtn);
    document.body.appendChild(overlay);

    const close = () => {
      overlay.classList.remove('is-open');
      document.body.style.overflow = '';
    };
    overlay.addEventListener('click', close);
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') close();
    });

    // Мініатюра у стрічці (.feed-item-thumb) — це посилання на допис, а
    // не збільшуване фото, тож lightbox навмисно чіпляється лише до
    // зображень на сторінці самого допису.
    document.querySelectorAll<HTMLImageElement>('.article-page img').forEach((img) => {
      img.addEventListener('click', () => {
        overlayImg.src = img.src;
        overlayImg.alt = img.alt;
        overlay.classList.add('is-open');
        document.body.style.overflow = 'hidden';
      });
    });
  }

  // Лайки/перегляди — окремий публічний Cloudflare Worker (той самий, що
  // приймає Telegram-нотатки, але через /reactions/*, без секрету бота).
  const REACTIONS_API = 'https://joewline-intake-bot.joewline.workers.dev/reactions';

  function setupReactions() {
    document.querySelectorAll<HTMLElement>('.reactions').forEach(async (el) => {
      const slug = el.dataset.slug;
      if (!slug) return;
      const trackView = el.dataset.trackView === '1';
      const likeBtn = el.querySelector<HTMLButtonElement>('.reaction-like');
      const likeCount = likeBtn?.querySelector<HTMLElement>('.reaction-count');
      const viewCount = el.querySelector<HTMLElement>('.reaction-views .reaction-count');
      const encodedSlug = encodeURIComponent(slug);

      const applyCounts = (data: { views?: number; likes?: number; liked?: boolean }) => {
        if (typeof data.likes === 'number' && likeCount) likeCount.textContent = String(data.likes);
        if (typeof data.views === 'number' && viewCount) viewCount.textContent = String(data.views);
        if (typeof data.liked === 'boolean' && likeBtn) {
          likeBtn.classList.toggle('is-liked', data.liked);
          likeBtn.setAttribute('aria-pressed', String(data.liked));
        }
      };

      try {
        const res = await fetch(`${REACTIONS_API}/counts/${encodedSlug}`);
        applyCounts(await res.json());
      } catch {
        // немає мережі чи Worker недоступний — лічильники просто лишаться "–"
      }

      if (trackView) {
        fetch(`${REACTIONS_API}/view/${encodedSlug}`, { method: 'POST' })
          .then((res) => res.json())
          .then(applyCounts)
          .catch(() => {});
      }

      likeBtn?.addEventListener('click', async () => {
        likeBtn.disabled = true;
        try {
          const res = await fetch(`${REACTIONS_API}/like/${encodedSlug}`, { method: 'POST' });
          applyCounts(await res.json());
        } catch {
          // залишити попередній стан, якщо запит не пройшов
        }
        likeBtn.disabled = false;
      });
    });
  }

  // Панель доступності: розмір тексту, контраст, шрифт для дислексії,
  // підкреслення посилань, менше анімації. Класи на <html> вже виставлені
  // синхронним is:inline скриптом у <head> (щоб не блимало) — тут лише
  // синхронізуємо UI-контроли зі збереженим станом і вішаємо обробники.
  function setupAccessibility() {
    const STORAGE_KEY = 'a11y-settings';
    const root = document.documentElement;
    const toggleBtn = document.getElementById('a11y-toggle');
    const panel = document.getElementById('a11y-panel');
    if (!toggleBtn || !panel) return;

    const load = (): Record<string, string | boolean> => {
      try {
        return JSON.parse(localStorage.getItem(STORAGE_KEY) || '{}');
      } catch {
        return {};
      }
    };
    const save = (settings: Record<string, string | boolean>) =>
      localStorage.setItem(STORAGE_KEY, JSON.stringify(settings));

    let settings = load();

    const FONT_CLASSES = ['a11y-font-lg', 'a11y-font-xl'];
    const TOGGLE_CLASSES: Record<string, string> = {
      contrast: 'a11y-contrast',
      dyslexia: 'a11y-dyslexia',
      underlineLinks: 'a11y-underline-links',
      reduceMotion: 'a11y-reduce-motion',
    };

    const applyFontSize = (size: string) => {
      root.classList.remove(...FONT_CLASSES);
      if (size) root.classList.add(`a11y-font-${size}`);
      panel.querySelectorAll<HTMLButtonElement>('[data-a11y-fontsize]').forEach((btn) => {
        btn.setAttribute('aria-pressed', String(btn.dataset.a11yFontsize === size));
      });
    };

    const applyToggle = (key: string, value: unknown) => {
      root.classList.toggle(TOGGLE_CLASSES[key], Boolean(value));
      const input = panel.querySelector<HTMLInputElement>(`[data-a11y-toggle="${key}"]`);
      if (input) input.checked = Boolean(value);
    };

    applyFontSize(typeof settings.fontSize === 'string' ? settings.fontSize : '');
    Object.keys(TOGGLE_CLASSES).forEach((key) => applyToggle(key, settings[key]));

    panel.querySelectorAll<HTMLButtonElement>('[data-a11y-fontsize]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const size = btn.dataset.a11yFontsize || '';
        settings = { ...settings, fontSize: size };
        save(settings);
        applyFontSize(size);
      });
    });

    panel.querySelectorAll<HTMLInputElement>('[data-a11y-toggle]').forEach((input) => {
      input.addEventListener('change', () => {
        const key = input.dataset.a11yToggle as string;
        settings = { ...settings, [key]: input.checked };
        save(settings);
        applyToggle(key, input.checked);
      });
    });

    document.getElementById('a11y-reset')?.addEventListener('click', () => {
      settings = {};
      localStorage.removeItem(STORAGE_KEY);
      applyFontSize('');
      Object.keys(TOGGLE_CLASSES).forEach((key) => applyToggle(key, false));
    });

    const openPanel = () => {
      panel.hidden = false;
      toggleBtn.setAttribute('aria-expanded', 'true');
      panel.querySelector<HTMLElement>('button, input')?.focus();
    };
    const closePanel = () => {
      panel.hidden = true;
      toggleBtn.setAttribute('aria-expanded', 'false');
    };

    toggleBtn.addEventListener('click', () => {
      if (panel.hidden) openPanel();
      else closePanel();
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !panel.hidden) {
        closePanel();
        toggleBtn.focus();
      }
    });

    document.addEventListener('click', (e) => {
      const target = e.target as Node;
      if (!panel.hidden && !panel.contains(target) && target !== toggleBtn && !toggleBtn.contains(target)) {
        closePanel();
      }
    });
  }

  setupCarousels();
  setupLightbox();
  setupReactions();
  setupAccessibility();
</script>

<script>
  // Реєстрація service worker для PWA. Astro не інжектить це сам (на
  // відміну від звичайного Vite SPA з одним index.html) — @vite-pwa/astro
  // лише генерує sw.js/manifest, реєструвати треба явно.
  import { registerSW } from 'virtual:pwa-register';
  registerSW({ immediate: true });
</script>
