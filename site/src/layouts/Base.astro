---
import '../styles/global.css';

interface Props {
  title: string;
}
const { title } = Astro.props;
---
<!doctype html>
<html lang="uk">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <title>{title} — joewline</title>
  </head>
  <body>
    <header class="site-header">
      <a href={import.meta.env.BASE_URL} class="brand">joewline</a>
      <nav class="site-nav">
        <a href={import.meta.env.BASE_URL}>стрічка</a>
        <a href={`${import.meta.env.BASE_URL}tags/`}>теги</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
  </body>
</html>
