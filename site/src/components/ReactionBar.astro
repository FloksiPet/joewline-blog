---
interface Props {
  slug: string;
  trackView?: boolean;
}

const { slug, trackView = false } = Astro.props;
---
<div class="reactions" data-slug={slug} data-track-view={trackView ? '1' : '0'}>
  <button type="button" class="reaction-like" aria-label="Подобається" aria-pressed="false">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M12 20.5s-7.2-4.6-9.8-8.6C.5 8.8 1.4 4.8 5 3.5c2.3-.8 4.6.1 6 2 .1.2.3.2.4 0 1.4-1.9 3.7-2.8 6-2 3.6 1.3 4.5 5.3 2.8 8.4-2.6 4-9.8 8.6-9.8 8.6z"></path>
    </svg>
    <span class="reaction-count">–</span>
  </button>
  <span class="reaction-views" aria-label="Переглядів">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M1.5 12S5 5.5 12 5.5 22.5 12 22.5 12 19 18.5 12 18.5 1.5 12 1.5 12z"></path>
      <circle cx="12" cy="12" r="3"></circle>
    </svg>
    <span class="reaction-count">–</span>
  </span>
</div>
