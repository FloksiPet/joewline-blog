---
import Tags from './Tags.astro';
import ReactionBar from './ReactionBar.astro';
import { displayKind, formatDate } from '../lib/labels';
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'cases'>;
  Content: any;
}

const { entry, Content } = Astro.props;
const kind = displayKind(entry);
---
<article class="feed-item" id={entry.slug}>
  <div class="feed-item-meta">
    <span class={`pill ${kind.className}`}>{kind.label}</span>
    <a class="permalink" href={`${import.meta.env.BASE_URL}${entry.slug}`}>
      <time datetime={entry.data.date.toISOString()}>{formatDate(entry.data.date)}</time>
    </a>
  </div>
  <h2><a href={`${import.meta.env.BASE_URL}${entry.slug}`}>{entry.data.title}</a></h2>
  <div class="feed-item-body">
    <Content />
  </div>
  <Tags tags={entry.data.tags} />
  <ReactionBar slug={entry.slug} />
</article>
