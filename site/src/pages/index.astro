---
import Base from '../layouts/Base.astro';
import Tags from '../components/Tags.astro';
import FeedItem from '../components/FeedItem.astro';
import { getCollection } from 'astro:content';
import { formatDate, displayKind } from '../lib/labels';
import { sortEntries, excerpt } from '../lib/entries';

// Стрічка — усе, що ще не "завершена стаття": чернетки, у процесі, думки,
// кейси в роботі. Кожен пункт — лише прев'ю (перший абзац + мініатюра,
// див. FeedItem.astro), повний текст — на сторінці самого допису. Завершені
// статті (status: done) з цієї стрічки прибираємо, щоб не дублювати — вони
// живуть окремим блоком праворуч.
const allEntries = sortEntries(await getCollection('cases'));

const articles = allEntries.filter((entry) => entry.data.status === 'done');
const feedEntries = allEntries.filter((entry) => entry.data.status !== 'done');
---
<Base title="стрічка" description="Стрічка нотаток і роздумів JoeWline: мікроконтролери, іграшки на залізі, автоматизація через ШІ — з окремим блоком завершених статей.">
  <div class="layout">
    <section class="feed" aria-label="стрічка нотаток">
      <div class="feed-controls">
        <input type="search" id="search-input" placeholder="пошук по стрічці…" aria-label="пошук по стрічці" />
      </div>
      {feedEntries.length === 0 && <p class="muted">Поки що порожньо.</p>}
      <div id="feed-items">
        {feedEntries.map((entry) => (
          <FeedItem entry={entry} />
        ))}
      </div>
      <p id="no-results" class="muted" hidden>Нічого не знайдено.</p>
    </section>

    <aside class="sidebar" aria-label="завершені статті">
      <h2>Завершені статті</h2>
      {articles.length === 0 ? (
        <p class="muted">Поки що немає завершених статей.</p>
      ) : (
        <ul class="case-list">
          {articles.map((entry) => (
            <li>
              <div class="meta-top">
                <span class={`pill ${displayKind(entry).className}`}>{displayKind(entry).label}</span>
              </div>
              <a href={`${import.meta.env.BASE_URL}${entry.slug}/`}>{entry.data.title}</a>
              <div class="meta">{formatDate(entry.data.date)}</div>
              <p class="excerpt">{excerpt(entry.body)}</p>
              <Tags tags={entry.data.tags} />
            </li>
          ))}
        </ul>
      )}
    </aside>
  </div>
</Base>

<script>
  const input = document.getElementById('search-input') as HTMLInputElement | null;
  const items = Array.from(document.querySelectorAll<HTMLElement>('.feed-item'));
  const noResults = document.getElementById('no-results');

  input?.addEventListener('input', () => {
    const query = input.value.trim().toLowerCase();
    let visibleCount = 0;

    items.forEach((item) => {
      const text = item.textContent?.toLowerCase() ?? '';
      const matches = query.length === 0 || text.includes(query);
      item.hidden = !matches;
      if (matches) visibleCount += 1;
    });

    if (noResults) noResults.hidden = visibleCount > 0;
  });
</script>
