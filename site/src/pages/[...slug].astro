---
import Base from '../layouts/Base.astro';
import Tags from '../components/Tags.astro';
import ReactionBar from '../components/ReactionBar.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import { displayKind, formatDate } from '../lib/labels';
import { excerpt, plainTextLength } from '../lib/entries';
import { firstImagePath } from '../lib/og';

export async function getStaticPaths() {
  const entries = await getCollection('cases');
  return entries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'cases'>;
}

const { entry } = Astro.props;
const { Content } = await entry.render();
const kind = displayKind(entry);

const description = excerpt(entry.body);
const imagePath = firstImagePath(entry.body);
const ogImage = imagePath ? `${import.meta.env.BASE_URL}${imagePath.replace(/^\//, '')}` : undefined;

// Коротенькі нотатки-на-два-слова пошуковикам не цікаві й лише
// розмивають видачу — не даємо їх індексувати, самі вони на сайті лишаються.
const INDEXABLE_MIN_LENGTH = 400;
const noindex = plainTextLength(entry.body) < INDEXABLE_MIN_LENGTH;
---
<Base
  title={entry.data.title}
  description={description}
  image={ogImage}
  type="article"
  publishedTime={entry.data.date.toISOString()}
  noindex={noindex}
>
  <article class="article-page">
    <p class="back-link"><a href={import.meta.env.BASE_URL}>&larr; уся стрічка</a></p>
    <h1>{entry.data.title}</h1>
    <div class="meta">
      <span class={`pill ${kind.className}`}>{kind.label}</span>
      {formatDate(entry.data.date)}
    </div>
    <Content />
    <Tags tags={entry.data.tags} />
    <ReactionBar slug={entry.slug} trackView />
  </article>
</Base>
